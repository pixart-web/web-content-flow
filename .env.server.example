# L7: private server settings for compose.yaml. Copy to .env.server (never
# commit it) and fill in every value marked REQUIRED.

# REQUIRED: public https URL and the host Caddy serves (no scheme).
APP_URL=https://wcf.example.com
DOMAIN=wcf.example.com
# Optional host ports for Caddy (default 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443

# REQUIRED secrets: generate each with `openssl rand -hex 32`.
# The auth secret is required too: add a line for AUTH_SECRET with its own
# generated value (the web refuses to start without it).
POSTGRES_PASSWORD=
RATE_LIMIT_SECRET=

APP_MODE=server
APP_ENV=production
DATABASE_ENVIRONMENT=production
ROLLOUT_STATE=INVITE_ONLY
PUBLIC_REGISTRATION_ENABLED=false
MARKETING_INDEXING_ENABLED=false

# REQUIRED: transactional email (password recovery).
EMAIL_PROVIDER=SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SUPPORT_EMAIL=

# AI: mock by default. Local models: point at an Ollama the server can reach
# (for example on the same host) and set AI_PROVIDER_DEFAULT=LOCAL once a
# model passed evaluation (docs/technical/48).
AI_PROVIDER_DEFAULT=MOCK
AI_REAL_GENERATION_ENABLED=false
# AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
# AI_OLLAMA_MODEL=gemma4:12b-it-qat
# KNOWLEDGE_EMBEDDING_MODEL=bge-m3
