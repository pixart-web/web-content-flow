# Public URL used for canonical application links in local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct PostgreSQL connection used by Prisma and Auth.js database sessions.
DATABASE_URL=postgresql://web_content_flow:web_content_flow@localhost:5432/web_content_flow
DATABASE_ENVIRONMENT=local

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Canonical Auth.js application URL.
AUTH_URL=http://localhost:3000

# Controlled launch and server-side feature policy.
APP_ENV=local
# Immutable Git SHA or release artifact identifier, shared by web/worker/cron.
APP_RELEASE=local-development
ROLLOUT_STATE=INTERNAL
PUBLIC_REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false
EXPORTS_ENABLED=true
PROJECT_PACKAGE_EXPORT_ENABLED=true
ACCOUNT_DELETION_ENABLED=false
PUBLIC_PRICING_ENABLED=true
MARKETING_INDEXING_ENABLED=false
MARKETING_CAPTURE_MODE=false

# Transactional account email. MOCK performs no network calls.
# SMTP is the selected production provider (D-3); RESEND remains supported.
EMAIL_PROVIDER=MOCK
# SMTP: port 587 uses mandatory STARTTLS (SMTP_SECURE=false); port 465 uses
# implicit TLS (SMTP_SECURE=true). Credentials never belong in this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=noreply@webcontentflow.local
SUPPORT_EMAIL=support@webcontentflow.local

# Replace draft versions only after legal review.
LEGAL_TERMS_VERSION=draft-2026-07
LEGAL_PRIVACY_VERSION=draft-2026-07

EXPORT_RETENTION_HOURS=24
EXPORT_MAX_BYTES=2000000

# Required in production. Generate a random value of at least 32 characters.
RATE_LIMIT_SECRET=

# Real generation is opt-in. Mock mode requires no provider secret.
AI_PROVIDER_DEFAULT=MOCK
AI_REAL_GENERATION_ENABLED=false

# Server/worker secret. Leave unset while real generation is disabled.
OPENAI_API_KEY=

# Server-controlled model policy. Users cannot submit arbitrary model IDs.
OPENAI_MODEL_STANDARD=gpt-5.6-terra
OPENAI_MODEL_PREMIUM=gpt-5.6-sol
OPENAI_MODEL_REPAIR=gpt-5.6-luna

AI_REQUEST_TIMEOUT_MS=60000
# Automatic retries for transient provider errors (0 disables). Total
# attempts never exceed the job's maxAttempts.
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_REQUESTS=4
AI_MAX_ACTIVE_PROJECT_JOBS=2
AI_MAX_REQUEST_INPUT_TOKENS=120000
AI_MAX_REQUEST_OUTPUT_TOKENS=12000
AI_DAILY_PROJECT_TOKEN_LIMIT=1000000
AI_MONTHLY_PROJECT_TOKEN_LIMIT=10000000
AI_DAILY_ACCOUNT_TOKEN_LIMIT=2000000
# Store estimated cost per usage record (requires registered model prices).
AI_COST_TRACKING_ENABLED=false
# Local/test only: print the resolved prompt to stdout. Rejected in production.
AI_PROMPT_DEBUG_ENABLED=false

# Test/CI only. Never enable in production.
AI_FAKE_OPENAI_ENABLED=false
