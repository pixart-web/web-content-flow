{
  "name": "web-content-flow",
  "version": "0.0.0",
  "private": true,
  "description": "Authenticated application foundation for Web Content Flow.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:provider": "vitest run src/server/ai/providers",
    "test:prompts": "vitest run src/ai/prompts src/ai/context",
    "test:usage": "vitest run src/server/ai/pricing.test.ts",
    "test:quota": "vitest run --config vitest.integration.config.ts tests/integration/ai-usage.integration.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/accessibility-smoke.spec.ts",
    "tokens:check": "node scripts/verify-design-tokens.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "capture:seed": "node --conditions=react-server --import tsx scripts/seed-marketing-capture.ts",
    "capture:stills": "node --import tsx scripts/capture-product-stills.ts",
    "worker": "NODE_OPTIONS=--conditions=react-server tsx scripts/run-worker.ts",
    "worker:once": "NODE_OPTIONS=--conditions=react-server tsx scripts/run-worker.ts --once",
    "eval:ai": "node --conditions=react-server --import tsx scripts/run-ai-eval.ts",
    "ai:health": "node --conditions=react-server --import tsx scripts/check-ai-runtimes.ts",
    "maintenance": "node --conditions=react-server --import tsx scripts/run-maintenance.ts",
    "migrate:check": "tsx scripts/check-migration-safety.ts",
    "migrate:production": "pnpm migrate:check && prisma migrate deploy",
    "restore:verify": "node --conditions=react-server --import tsx scripts/verify-restore.ts",
    "licenses:check": "license-checker-rseidelsohn --production --summary",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:client-bundle": "node scripts/scan-client-bundle.mjs",
    "secrets:scan": "pnpm security:secrets",
    "client-secrets:scan": "pnpm security:client-bundle",
    "licences:check": "pnpm licenses:check",
    "test:email": "vitest run src/server/email src/server/auth/password-recovery.test.ts",
    "test:export": "vitest run src/server/export",
    "test:security": "vitest run src/server/security src/app/health",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm tokens:check && pnpm test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.5.0",
    "openai": "^6.49.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "18.0.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
